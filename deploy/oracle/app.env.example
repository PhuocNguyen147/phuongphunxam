NODE_ENV=production
PORT=8787

# Doi thanh mat khau admin that cua ban.
ADMIN_PASSWORD=doi-mat-khau-admin-cua-ban

# Tao chuoi bi mat dai, kho doan. Co the chay:
# openssl rand -hex 32
ADMIN_TOKEN_SECRET=doi-chuoi-bi-mat-dai-kho-doan

# Khuyen dung Supabase de du lieu admin, anh va lich hen khong mat khi cap nhat code.
# Neu chua dung Supabase, app van chay bang volume Docker tren VPS.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=phuong-beauty
SUPABASE_DATA_TABLE=app_data
